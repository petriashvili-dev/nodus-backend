{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=nodus;Username=nodus;Password=nodus"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Issuer": "nodus",
    "Audience": "nodus-ios",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 60,
    "RotationGraceSeconds": 120
  },
  "EmailOtp": {
    "CodeExpiryMinutes": 10,
    "ResendCooldownSeconds": 60,
    "MaxCodesPerHour": 5,
    "MaxAttempts": 5,
    "HashPepper": ""
  },
  "Resend": {
    "ApiKey": "",
    "From": ""
  },
  "RateLimits": {
    "AuthPerMinute": 20,
    "OtpPerMinute": 10,
    "AiPerMinute": 10
  },
  "ReverseProxy": {
    "TrustForwardedHeaders": false
  },
  "Occurrences": {
    "HorizonDays": 45,
    "MaxCompletionBackdateDays": 30
  },
  "Outbox": {
    "PollSeconds": 5,
    "BatchSize": 100,
    "MaxAttempts": 10
  },
  "Retention": {
    "IdempotencyDays": 30,
    "SyncChangeDays": 90,
    "ProcessedOutboxDays": 7,
    "EmailCodeDays": 7
  },
  "Hangfire": {
    "Enabled": true,
    "WorkerCount": 4
  },
  "Apns": {
    "KeyId": "",
    "TeamId": "",
    "BundleId": "",
    "PrivateKey": "",
    "PreferSandbox": false
  },
  "Sse": {
    "HeartbeatSeconds": 20,
    "RetryMilliseconds": 3000
  }
}
