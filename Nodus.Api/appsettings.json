{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=nodus;Username=nodus;Password=nodus"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Issuer": "nodus",
    "Audience": "nodus-ios",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 60,
    "RotationGraceSeconds": 120
  },
  "EmailOtp": {
    "CodeExpiryMinutes": 10,
    "ResendCooldownSeconds": 60,
    "MaxCodesPerHour": 5,
    "MaxAttempts": 5,
    "HashPepper": ""
  },
  "Resend": {
    "ApiKey": "",
    "From": ""
  },
  "RateLimits": {
    "AuthPerMinute": 20,
    "OtpPerMinute": 10,
    "AiPerMinute": 10
  },
  "ReverseProxy": {
    "TrustForwardedHeaders": false
  },
  "Occurrences": {
    "HorizonDays": 45,
    "MaxCompletionBackdateDays": 30
  },
  "Outbox": {
    "PollSeconds": 5,
    "BatchSize": 100,
    "MaxAttempts": 10,
    "RunInBackground": true
  },
  "Retention": {
    "IdempotencyDays": 30,
    "SyncChangeDays": 90,
    "ProcessedOutboxDays": 7,
    "EmailCodeDays": 7,
    "ContinuationCacheDays": 180
  },
  "Hangfire": {
    "Enabled": true,
    "WorkerCount": 4
  },
  "Apns": {
    "KeyId": "",
    "TeamId": "",
    "BundleId": "",
    "PrivateKey": "",
    "PreferSandbox": false
  },
  "Sse": {
    "HeartbeatSeconds": 20,
    "RetryMilliseconds": 3000
  },
  "Connections": {
    "InviteLifetimeHours": 24,
    "MaxPendingInvites": 10,
    "InviteLinkBase": "https://nodus.app/invite/"
  },
  "Llm": {
    "TotalTimeoutSeconds": 150,
    "CircuitFailureThreshold": 5,
    "CircuitBreakSeconds": 60,
    "LogContent": false,
    "Providers": [
      {
        "Name": "neuroapi",
        "Priority": 1,
        "BaseUrl": "https://neuroapi.host",
        "ApiKey": "",
        "Model": "",
        "TimeoutSeconds": 60,
        "MaxAttempts": 2,
        "SupportsJsonSchema": false,
        "MaxRequestsPerMinute": 60,
        "InputCostPerMillion": null,
        "OutputCostPerMillion": null
      },
      {
        "Name": "timeweb",
        "Priority": 2,
        "BaseUrl": "https://api.timeweb.ai",
        "ApiKey": "",
        "Model": "",
        "TimeoutSeconds": 60,
        "MaxAttempts": 1,
        "SupportsJsonSchema": false,
        "MaxRequestsPerMinute": 60,
        "InputCostPerMillion": null,
        "OutputCostPerMillion": null
      }
    ]
  },
  "Ai": {
    "MaxTextLength": 4000,
    "MaxJobsPerDay": 50,
    "MaxAttempts": 3,
    "DraftRetentionDays": 14,
    "InputRetentionHours": 24
  },
  "AiContinuations": {
    "Enabled": true,
    "DebounceSeconds": 20,
    "MaxLlmCallsPerUserPerDay": 30
  }
}
