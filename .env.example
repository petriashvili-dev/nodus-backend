# Nodus on the Eatee production server: paste into Dokploy Environment.
# Replace all REPLACE_WITH_* placeholders before deployment. No actual secrets here.
# The same database password must be entered in BOTH lines below.
POSTGRES_DB=nodus
POSTGRES_USER=nodus
POSTGRES_PASSWORD=REPLACE_WITH_NEW_DB_PASSWORD
ConnectionStrings__Postgres=Host=db;Port=5432;Database=nodus;Username=nodus;Password=REPLACE_WITH_NEW_DB_PASSWORD

# ── Logging ──
Logging__LogLevel__Default=Information

# ── AllowedHosts ──
AllowedHosts=*

# ── Database ──
Database__StartupTimeoutSeconds=180
Database__StartupRetrySeconds=2

# ── Jwt ──
Jwt__Issuer=nodus
Jwt__Audience=nodus-ios
# TODO: обязательно задать секрет
Jwt__SigningKey=REPLACE_WITH_NEW_JWT_SECRET
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=60
Jwt__RotationGraceSeconds=120

# ── EmailOtp ──
EmailOtp__CodeExpiryMinutes=10
EmailOtp__ResendCooldownSeconds=60
EmailOtp__MaxCodesPerHour=5
EmailOtp__MaxAttempts=5
# TODO: обязательно задать секрет
EmailOtp__HashPepper=REPLACE_WITH_NEW_HASH_PEPPER
# Не нужен в Live
EmailOtp__MockCode=
# Не используется; оставить пустым
EmailOtp__ReviewEmails__0=
# Не используется; оставить пустым
EmailOtp__ReviewCode=

# ── ServiceMode ──
ServiceMode__Email=Live

# ── EmailOptions ──
EmailOptions__FromAddress=nodus@eatee.ru
EmailOptions__FromName=Nodus
EmailOptions__Smtp__Host=eatee-infrastructure-wajrxt_mail
EmailOptions__Smtp__Port=25
EmailOptions__Smtp__Security=None
EmailOptions__Smtp__Authentication=false
EmailOptions__Smtp__Username=
EmailOptions__Smtp__Password=
EmailOptions__Smtp__TimeoutSeconds=15

# ── RateLimits ──
RateLimits__AuthPerMinute=20
RateLimits__OtpPerMinute=10
RateLimits__AiPerMinute=10

# ── ReverseProxy ──
ReverseProxy__TrustForwardedHeaders=true

# ── Occurrences ──
Occurrences__HorizonDays=45
Occurrences__MaxCompletionBackdateDays=30

# ── Outbox ──
Outbox__PollSeconds=5
Outbox__BatchSize=100
Outbox__MaxAttempts=10
Outbox__RunInBackground=true

# ── Retention ──
Retention__IdempotencyDays=30
Retention__SyncChangeDays=90
Retention__ProcessedOutboxDays=7
Retention__EmailCodeDays=7
Retention__ContinuationCacheDays=180

# ── Hangfire ──
Hangfire__Enabled=true
Hangfire__WorkerCount=4

# ── Apns ──
# Серверные push отключены до настройки Apple; локальные напоминания работают отдельно.
Apns__Enabled=false
# TODO: неизвестно; нужно при включении сервиса
Apns__KeyId=
# TODO: неизвестно; нужно при включении сервиса
Apns__TeamId=
# Проектное значение; подтвердить для production
Apns__BundleId=app.nodus
# TODO: неизвестно; нужно при включении сервиса
Apns__PrivateKey=
Apns__PreferSandbox=false

# ── Sse ──
Sse__HeartbeatSeconds=20
Sse__RetryMilliseconds=3000
Sse__MaxConnectionsPerUser=5

# ── Connections ──
Connections__InviteLifetimeHours=24
Connections__MaxPendingInvites=10
# Проектное значение; подтвердить для production
Connections__InviteLinkBase=https://nodus.app/invite/

# ── Llm ──
Llm__TotalTimeoutSeconds=150
Llm__CircuitFailureThreshold=5
Llm__CircuitBreakSeconds=60
Llm__LogContent=false
Llm__Providers__0__Name=neuroapi
Llm__Providers__0__Priority=1
Llm__Providers__0__BaseUrl=https://neuroapi.host
# TODO: неизвестно; нужно при включении сервиса
Llm__Providers__0__ApiKey=
# TODO: неизвестно; нужно при включении сервиса
Llm__Providers__0__Model=
Llm__Providers__0__TimeoutSeconds=60
Llm__Providers__0__MaxAttempts=2
Llm__Providers__0__SupportsJsonSchema=false
Llm__Providers__0__MaxRequestsPerMinute=60
# Не задано; учёт стоимости отключён
Llm__Providers__0__InputCostPerMillion=
# Не задано; учёт стоимости отключён
Llm__Providers__0__OutputCostPerMillion=
Llm__Providers__1__Name=timeweb
Llm__Providers__1__Priority=2
Llm__Providers__1__BaseUrl=https://api.timeweb.ai
# TODO: неизвестно; нужно при включении сервиса
Llm__Providers__1__ApiKey=
# TODO: неизвестно; нужно при включении сервиса
Llm__Providers__1__Model=
Llm__Providers__1__TimeoutSeconds=60
Llm__Providers__1__MaxAttempts=1
Llm__Providers__1__SupportsJsonSchema=false
Llm__Providers__1__MaxRequestsPerMinute=60
# Не задано; учёт стоимости отключён
Llm__Providers__1__InputCostPerMillion=
# Не задано; учёт стоимости отключён
Llm__Providers__1__OutputCostPerMillion=

# ── Ai ──
Ai__MaxTextLength=4000
Ai__MaxJobsPerDay=50
Ai__MaxAttempts=3
Ai__DraftRetentionDays=14
Ai__InputRetentionHours=24

# ── AppConfig ──
AppConfig__CacheSeconds=15

# ── Plans ──
Plans__Plus__Features__0=ai_drafts
Plans__Plus__Features__1=ai_continuations
Plans__Plus__Features__2=ai_import

# ── AiContinuations ──
AiContinuations__Enabled=true
AiContinuations__DebounceSeconds=20
AiContinuations__MaxLlmCallsPerUserPerDay=30

# ── Observability ──
Observability__PrometheusEnabled=false
Observability__OtlpEndpoint=
Observability__JsonLogs=true

# ── Import ──
Import__MaxContentChars=200000
Import__MaxAiInputChars=30000
Import__MaxNodes=1000
Import__MaxAiImportsPerDay=5
Import__MaxAttempts=3
Import__PreviewRetentionDays=7

# Fixed in docker-compose.yml: image, domain, networks, volume, Production,
# ASPNETCORE_URLS=http://+:8080;http://+:9464, Database__MigrateOnStartup=false,
# Observability__MetricsPort=9464 and framework/SQL log levels=Warning.
# APP_COMMIT / APP_BUILD_TIME come from the image build.
# Plans__Standard__Features defaults to [].
# ACME/REG.RU/proxy credentials belong to Traefik, not this Environment.
