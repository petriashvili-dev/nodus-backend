# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# ── Deployment ────────────────────────────────────────────────
NODUS_DOMAIN=api.nodus.app
ASPNETCORE_ENVIRONMENT=Production

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=nodus
POSTGRES_USER=nodus
POSTGRES_PASSWORD=

# ── Required secrets ──────────────────────────────────────────
# openssl rand -base64 48
Jwt__SigningKey=
# openssl rand -base64 24  (do not change on a running system: codes and AI cache keys depend on it)
EmailOtp__HashPepper=

# ── Resend (email codes) ──────────────────────────────────────
Resend__ApiKey=
Resend__From=Nodus <no-reply@nodus.app>

# ── APNs (.p8 key) ────────────────────────────────────────────
Apns__KeyId=
Apns__TeamId=
Apns__BundleId=
# Contents of the .p8 file; PEM with literal \n is fine.
Apns__PrivateKey=

# ── LLM providers (OpenAI-compatible) ─────────────────────────
# 0 — primary neuroapi.host, 1 — secondary Timeweb Cloud (base URLs are in appsettings.json).
Llm__Providers__0__ApiKey=
Llm__Providers__0__Model=
Llm__Providers__1__ApiKey=
Llm__Providers__1__Model=

# ── Invitations ───────────────────────────────────────────────
Connections__InviteLinkBase=https://nodus.app/invite/

# ── Observability (optional) ──────────────────────────────────
# /metrics is served on port 9464 only (not routed by Traefik): scrape nodus-api:9464 inside the Docker network.
Observability__PrometheusEnabled=false
Observability__OtlpEndpoint=
